RewriteEngine On
RewriteBase /

# Authorization ヘッダーをPHPに渡す（APIのBearerトークン用）
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# /web/* => backend/v1.php
RewriteRule ^web/(.*)$ backend/v1.php [L,QSA]

# /api/* => backend/v1.php
RewriteRule ^api/(.*)$ backend/v1.php [L,QSA]

<IfModule mod_dir.c>
  DirectoryIndex index.html index.php
</IfModule>

# 存在しないURLはエラーページ
ErrorDocument 404 /error/404.html
ErrorDocument 403 /error/403.html
ErrorDocument 500 /error/500.html
# キャッシュ制御（HTML は毎回サーバーに確認させ、更新が即反映されるようにする。
# CSS / JS は index.html 側の ?v=内容ハッシュ で更新が伝わるため長期キャッシュ可）
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
