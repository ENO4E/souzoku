# お問い合わせフォーム送信API（api/contact.js）用の環境変数
# 本番では Vercel の Project Settings > Environment Variables に設定する（このファイルには値を書かない）

# 送信先メールアドレス（フォームの内容が届くアドレス）
CONTACT_TO=

# 送信に使うメールアカウント（Gmail の場合はアカウントのメールアドレスと「アプリ パスワード」）
SMTP_USER=
SMTP_PASS=

# 任意（省略時は Gmail: smtp.gmail.com / 465）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
