RewriteEngine On
RewriteBase /

# Authorization ヘッダーをPHPに渡す（APIのBearerトークン用）
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# /web/* => backend/v1.php
RewriteRule ^web/(.*)$ backend/v1.php [L,QSA]

# /api/* => backend/v1.php
RewriteRule ^api/(.*)$ backend/v1.php [L,QSA]

<IfModule mod_dir.c>
  DirectoryIndex index.html index.php
</IfModule>

# 存在しないURLはエラーページ
ErrorDocument 404 /error/404.html
ErrorDocument 403 /error/403.html
ErrorDocument 500 /error/500.html